# Modelo das configurações secretas do Orçamentos.
# Copie este arquivo com o nome .env.local (só para testar no computador).
# O .env.local NUNCA vai para o Git (está no .gitignore).

# NO COMPUTADOR, DEIXE VAZIO: o teste usa um banco local (pasta dados/banco-local).
# Na Vercel, a DATABASE_URL vem do banco Neon ligado ao projeto.
DATABASE_URL=

# Segredo do passe do portal: o MESMO valor do portal (está no .env.local da pasta taxi20-app).
# Para testar no computador, qualquer texto com 32 caracteres ou mais serve.
PORTAL_PASSE_SEGREDO=
